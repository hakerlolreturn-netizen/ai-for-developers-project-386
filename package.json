{
  "name": "ai-for-developers-project-386",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n backend,frontend \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "oxlint --deny-warnings && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10"
  }
}
